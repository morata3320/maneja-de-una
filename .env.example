# Solo para PostgreSQL local mediante Docker Compose.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=maneja_de_una
DB_USER=maneja_de_una
# Reemplazar en .env local; nunca versionar credenciales reales.
DB_PASSWORD=replace-with-local-development-password

# Render: habilita una ejecución idempotente del seed de catálogo al arrancar.
RUN_CATALOG_SEED=false
