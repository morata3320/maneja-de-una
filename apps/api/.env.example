NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=maneja_de_una
DB_USER=maneja_de_una
DB_PASSWORD=replace-with-local-development-password
DB_SSL=false

# Solo en Render y temporalmente: ejecuta el seed idempotente antes de iniciar.
RUN_CATALOG_SEED=false

# OAuth contractual. local es exclusivo para desarrollo y pruebas.
AUTH_MODE=local
AUTH_ISSUER=urn:autos:local
AUTH_AUDIENCE=autos-api
AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
AUTOS_LOCAL_JWT_SECRET=replace-with-32-or-more-random-characters-autos

# La API interna usa otro emisor, audiencia y secreto.
INTERNAL_JWT_SECRET=replace-with-32-or-more-random-characters-internal
JWT_EXPIRES_IN=1h
PAGINATION_SECRET=replace-with-32-or-more-random-characters-pages
WEBHOOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

SEARCH_TOKEN_TTL_MINUTES=15
HOLD_TTL_MINUTES=10
PREVIEW_TTL_MINUTES=15
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_ALLOW_LOOPBACK=false

# Opcionales. En Render crean de forma idempotente un ADMIN después de migrar.
# Deben definirse ambas; nunca se imprime ni versiona la contraseña.
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=replace-with-a-long-local-password
# SEED_USER_EMAIL=user@example.test
# SEED_USER_PASSWORD=replace-with-a-long-local-password
