NODE_ENV=development
HOST=0.0.0.0
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=maneja_de_una
DB_USER=maneja_de_una
DB_PASSWORD=SET_LOCAL_PASSWORD_FROM_EXISTING_DOCKER_ENV
DB_SSL=false
# Una clave de 32+ caracteres distinta a tu contraseña de PostgreSQL
BOOKING_API_KEY=REPLACE_WITH_LONG_RANDOM_KEY_32_PLUS
ADMIN_API_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_KEY_32_PLUS
AUTOS_NODE_ID=maneja-de-una
AUTOS_NODE_NAME=MANEJA DE UNA
# Puerto de Booking por Tailscale; dejar vacío hasta obtener IP real
BOOKING_GRPC_ADDR=
BOOKING_GRPC_TLS=false
STOCK_SYNC_ENABLED=false
STOCK_SYNC_INTERVAL_MS=5000
# Permitir manualmente bases remotas solo si realmente sabes lo que haces
ALLOW_NONLOCAL_DATABASE=false
